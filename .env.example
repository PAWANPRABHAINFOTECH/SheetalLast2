# ==========================================================
# Sheetal Shivalaya Samiti — Environment Variables (EXAMPLE)
# Copy to .env and fill with your own values. NEVER commit .env
# ==========================================================

# Public Supabase project URL (client + server)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable / anon key (safe for browser)
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_or_anon_key
SUPABASE_PUBLISHABLE_KEY=your_publishable_or_anon_key

# Project ref (optional, used by tooling)
VITE_SUPABASE_PROJECT_ID=your-project-ref

# SERVER ONLY — never expose in the browser or commit to git
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
